# Database (already configured in sandbox)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Evidence gathering ────────────────────────────────────────────────────────
# Optional but strongly recommended. Without it, analysis falls back to pure
# LLM inference with no real web evidence. Free tier: 1,000 credits/month,
# no card required — https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. Every request to /api/* must send this value in an
# `x-api-key` header (or `Authorization: Bearer <key>`). Generate a random
# string, e.g.: openssl rand -hex 32
APP_API_KEY=

# ─── AI Configuration ────────────────────────────────────────────────────────
# The app uses the OpenAI client format, but works with any compatible provider.

# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini   (default)
# AI_MODEL=gpt-4o        (more capable, higher cost)

# Option 2: Groq (fast, free tier available — https://console.groq.com)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Option 3: Mistral (https://console.mistral.ai)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-large-latest

# Option 4: Local Ollama (free, runs locally)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b

# Option 5: Together AI (https://api.together.xyz)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
